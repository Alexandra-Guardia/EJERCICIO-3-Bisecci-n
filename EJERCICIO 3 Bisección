import numpy as np  # Importa la librería NumPy para operaciones matemáticas
import matplotlib.pyplot as plt  # Importa Matplotlib para graficar

# Definir la función a analizar
def f(x):
    return np.cos(x) - x  # Retorna el valor de cos(x) - x

# Algoritmo del Método de Bisección
def biseccion(a, b, tol=1e-5, max_iter=100):
    if f(a) * f(b) >= 0:  # Verifica si el método de bisección es aplicable
        print("El método de bisección no es aplicable en el intervalo dado.")
        return None  # Retorna None si no se cumple la condición de cambio de signo

    # Listas para almacenar los valores de cada iteración
    iteraciones = []  # Lista para almacenar los valores de 'c' en cada iteración
    errores_abs = []  # Lista para almacenar los errores absolutos
    errores_rel = []  # Lista para almacenar los errores relativos
    errores_cuad = []  # Lista para almacenar los errores cuadráticos
    c_old = a  # Inicializa 'c_old' con 'a' para el cálculo de errores

    # Imprime encabezado de la tabla de iteraciones
    print("\nIteraciones del Método de Bisección:")
    print("Iter |       a       |       b       |       c       |      f(c)      |     Error Abs     |     Error Rel     |    Error Cuad     ")
    print("-" * 135)

    for i in range(max_iter):  # Bucle para iterar hasta el máximo de iteraciones
        c = (a + b) / 2  # Calcula el punto medio del intervalo actual
        iteraciones.append(c)  # Almacena el valor de 'c'

        # Cálculo de errores
        error_abs = abs(c - c_old)  # Error absoluto
        error_rel = abs((c - c_old) / c) if c != 0 else 0  # Error relativo
        error_cuad = error_abs**2  # Error cuadrático
        errores_abs.append(error_abs)  # Guarda error absoluto
        errores_rel.append(error_rel)  # Guarda error relativo
        errores_cuad.append(error_cuad)  # Guarda error cuadrático

        # Imprime los valores de cada iteración en la tabla
        print(f"{i+1:4d} | {a:.8f} | {b:.8f} | {c:.8f} | {f(c):.8f} | {error_abs:.8e} | {error_rel:.8e} | {error_cuad:.8e}")

        # Criterio de parada: si f(c) es suficientemente pequeño o el error absoluto es menor que la tolerancia
        if abs(f(c)) < tol or error_abs < tol:
            break

        # Actualización del intervalo según el signo de f(c)
        if f(a) * f(c) < 0:
            b = c  # El nuevo intervalo es [a, c]
        else:
            a = c  # El nuevo intervalo es [c, b]

        c_old = c  # Actualiza 'c_old' para la siguiente iteración

    return iteraciones, errores_abs, errores_rel, errores_cuad  # Retorna las listas de iteraciones y errores

# Parámetros iniciales
a, b = 0, 1  # Intervalo inicial para la búsqueda de la raíz
iteraciones, errores_abs, errores_rel, errores_cuad = biseccion(a, b)  # Llama a la función de bisección

# Crear una figura para la convergencia del método de bisección
x = np.linspace(a - 1, b + 1, 400)  # Genera valores de x para la gráfica
y = f(x)  # Evalúa la función en esos valores
fig, ax1 = plt.subplots(figsize=(8, 6))  # Crea una figura con tamaño específico
ax1.plot(x, y, label=r'$f(x) = \cos(x) - x$', color='b')  # Grafica la función
ax1.axhline(0, color='k', linestyle='--', linewidth=1)  # Dibuja la línea y=0
ax1.scatter(iteraciones, [f(c) for c in iteraciones], color='red', label='Iteraciones')  # Marca los puntos iterados
ax1.set_xlabel('x')  # Etiqueta del eje x
ax1.set_ylabel('f(x)')  # Etiqueta del eje y
ax1.set_title("Convergencia del Método de Bisección")  # Título de la gráfica
ax1.legend()  # Agrega una leyenda
ax1.grid()  # Agrega una cuadrícula
plt.savefig("convergencia_biseccion.png", dpi=300)  # Guarda la gráfica como imagen
plt.show()  # Muestra la gráfica

# Crear una figura con los tres errores en una sola gráfica
fig, ax2 = plt.subplots(figsize=(8, 6))  # Crea una nueva figura
ax2.plot(range(1, len(errores_abs)+1), errores_abs, marker='o', linestyle='-', color='r', label="Error Absoluto")  # Grafica el error absoluto
ax2.plot(range(1, len(errores_rel)+1), errores_rel, marker='s', linestyle='-', color='g', label="Error Relativo")  # Grafica el error relativo
ax2.plot(range(1, len(errores_cuad)+1), errores_cuad, marker='^', linestyle='-', color='b', label="Error Cuadrático")  # Grafica el error cuadrático
ax2.set_yscale("log")  # Usa escala logarítmica en el eje y
ax2.set_xlabel("Iteración")  # Etiqueta del eje x
ax2.set_ylabel("Error")  # Etiqueta del eje y
ax2.set_title("Errores Absoluto, Relativo y Cuadrático en cada Iteración")  # Título de la gráfica
ax2.legend()  # Agrega una leyenda
ax2.grid()  # Agrega una cuadrícula
plt.savefig("errores_biseccion.png", dpi=300)  # Guarda la gráfica como imagen
plt.show()  # Muestra la gráfica
